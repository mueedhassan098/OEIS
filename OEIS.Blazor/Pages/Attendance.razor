@page "/attendance"

@using OEIS.Application.Common
@inject HttpClient Http
@inject OEIS.Blazor.Services.AuthState AuthState
@inject ISnackbar Snackbar

<PageHeader Title="My attendance"
            Subtitle="Check in for today and review your monthly history. All times are UTC+05:00." />

@if (!AuthState.IsAuthenticated)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="rounded-lg">Please sign in to manage attendance.</MudAlert>
}
else
{
    <MudGrid Spacing="4">
        <MudItem xs="12" lg="5">
            <MudPaper Elevation="0" Class="pa-5 rounded-xl oeis-surface h-100">
                <MudText Typo="Typo.overline" Style="opacity:.65">Today (UTC+05:00)</MudText>
                <MudText Typo="Typo.h6" Class="mb-1">Check in</MudText>
                <MudText Typo="Typo.body2" Class="mb-4" Style="opacity:.75">Record your start time for the day.</MudText>

                <EditForm Model="_checkIn" OnValidSubmit="OnCheckIn">
                    <DataAnnotationsValidator />
                    <MudStack Spacing="3">
                        <MudDatePicker @bind-Date="_checkInDate" Label="Date" Variant="Variant.Outlined" DateFormat="yyyy-MM-dd" />
                        <MudTextField @bind-Value="_checkIn.EntryTimeString"
                                      Label="Time (UTC+05:00)"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Time"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Schedule" />
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Update"
                                   OnClick="UseCurrentTime">
                            Use current time (UTC+05:00)
                        </MudButton>
                        <ValidationSummary />
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   ButtonType="ButtonType.Submit"
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Login">
                            Check in
                        </MudButton>
                    </MudStack>
                </EditForm>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="7">
            <MudPaper Elevation="0" Class="rounded-xl oeis-surface overflow-hidden h-100">
                <MudToolBar Dense="false" Class="px-4 py-3 border-b mud-border-lines-default">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-semibold">History</MudText>
                    <MudSpacer />
                    <MudText Typo="Typo.caption" Style="opacity:.65">Filter by month and year</MudText>
                </MudToolBar>
                <div class="pa-4">
                    <EditForm Model="_query" OnValidSubmit="LoadMonthly">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Class="flex-wrap mb-4">
                            <MudNumericField @bind-Value="_query.Month" Label="Month" Variant="Variant.Outlined" Min="1" Max="12" Style="max-width: 120px;" />
                            <MudNumericField @bind-Value="_query.Year" Label="Year" Variant="Variant.Outlined" Style="max-width: 120px;" />
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" ButtonType="ButtonType.Submit" StartIcon="@Icons.Material.Filled.Refresh">Load</MudButton>
                        </MudStack>
                    </EditForm>

                    @if (_records is null)
                    {
                        <MudText Style="opacity:.65"><em>No data loaded</em></MudText>
                    }
                    else if (_records.Count == 0)
                    {
                        <MudText Style="opacity:.65"><em>No attendance records for this month.</em></MudText>
                    }
                    else
                    {
                        <MudTable T="AttendanceVm" Items="@_records" Hover="true" Striped="true" Dense="false" Breakpoint="Breakpoint.Sm" Elevation="0">
                            <HeaderContent>
                                <MudTh>Date</MudTh>
                                <MudTh>Entry</MudTh>
                                <MudTh>Exit</MudTh>
                                <MudTh>Hours</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                @{
                                    var hours = GetHours(context);
                                }
                                <MudTd DataLabel="Date">@context.Date</MudTd>
                                <MudTd DataLabel="Entry">@FormatTime(context.EntryTime)</MudTd>
                                <MudTd DataLabel="Exit">
                                    @if (context.ExitTime is null)
                                    {
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => CheckOut(context.AttendanceId))">
                                            Check out
                                        </MudButton>
                                    }
                                    else
                                    {
                                        @FormatTime(context.ExitTime.Value)
                                    }
                                </MudTd>
                                <MudTd DataLabel="Hours">@(hours?.ToString("0.0") ?? "—")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private DateTime? _checkInDate;

    private AttendanceCheckInVm _checkIn = new();

    private MonthlyQueryVm _query = new();

    private List<AttendanceVm>? _records;

    protected override async Task OnInitializedAsync()
    {
        ApplyCurrentDateTimeDefaults();

        if (AuthState.IsAuthenticated)
        {
            await LoadMonthly();
        }
    }

    private void ApplyCurrentDateTimeDefaults()
    {
        var now = AppTime.Now;
        _checkInDate = now.Date;
        _checkIn.EntryDate = now.Date;
        _checkIn.EntryTimeString = now.ToString("HH:mm");
        _query.Month = now.Month;
        _query.Year = now.Year;
    }

    private void UseCurrentTime()
    {
        ApplyCurrentDateTimeDefaults();
        Snackbar.Add($"Set to {AppTime.Now:yyyy-MM-dd HH:mm} (UTC+05:00).", Severity.Info);
    }

    private async Task OnCheckIn()
    {
        if (_checkInDate.HasValue)
        {
            _checkIn.EntryDate = _checkInDate.Value;
        }

        if (!TimeSpan.TryParse(_checkIn.EntryTimeString, out var time))
        {
            Snackbar.Add("Enter a valid time.", Severity.Warning);
            return;
        }

        if (!AuthState.IsAuthenticated)
        {
            return;
        }

        var dto = new
        {
            EmployeeId = AuthState.CurrentUser!.EmployeeId,
            EntryTime = _checkIn.EntryDate.Date + time
        };

        var resp = await Http.PostAsJsonAsync("api/attendance/check-in", dto);
        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Checked in successfully.", Severity.Success);
            await LoadMonthly();
        }
        else
        {
            Snackbar.Add("Check-in failed.", Severity.Error);
        }
    }

    private async Task CheckOut(int attendanceId)
    {
        var dto = new
        {
            AttendanceId = attendanceId,
            ExitTime = AppTime.Now
        };
        var resp = await Http.PostAsJsonAsync("api/attendance/check-out", dto);
        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Checked out.", Severity.Success);
            await LoadMonthly();
        }
        else
        {
            Snackbar.Add("Check-out failed.", Severity.Error);
        }
    }

    private async Task LoadMonthly()
    {
        if (!AuthState.IsAuthenticated)
        {
            _records = new();
            return;
        }

        var employeeId = AuthState.CurrentUser!.EmployeeId;
        var url = $"api/attendance/monthly?employeeId={employeeId}&month={_query.Month}&year={_query.Year}";
        _records = await Http.GetFromJsonAsync<List<AttendanceVm>>(url);
    }

    private static string FormatTime(DateTime value) => $"{value:yyyy-MM-dd HH:mm}";

    public class AttendanceCheckInVm
    {
        public DateTime EntryDate { get; set; }
        public string EntryTimeString { get; set; } = "09:00";
    }

    public class MonthlyQueryVm
    {
        public int Month { get; set; }
        public int Year { get; set; }
    }

    public class AttendanceVm
    {
        public int AttendanceId { get; set; }
        public int EmployeeId { get; set; }
        public DateTime EntryTime { get; set; }
        public DateTime? ExitTime { get; set; }
        public DateOnly Date { get; set; }
    }

    private static double? GetHours(AttendanceVm a)
    {
        if (a.ExitTime is null) return null;
        var span = a.ExitTime.Value - a.EntryTime;
        if (span.TotalMinutes <= 0) return null;
        return span.TotalHours;
    }
}

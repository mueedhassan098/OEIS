@page "/forgot-password"

@using OEIS.Application.DTOs
@using OEIS.Blazor.Services
@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center oeis-login-wrap">
    <MudPaper Elevation="8" Class="pa-8 pa-sm-10 w-100 rounded-xl oeis-login-card oeis-animate-in">
        <div class="text-center mb-6">
            <MudText Typo="Typo.h4" Class="font-weight-bold mb-2">Forgot password</MudText>
            <MudText Typo="Typo.body2" Style="opacity:.75">
                Enter the email you used to register. A reset link will appear on this page.
            </MudText>
        </div>

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                @_successMessage
            </MudAlert>

            @if (!string.IsNullOrWhiteSpace(_resetLink))
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        Use this link to reset your password (valid for 60 minutes):
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               OnClick="@GoToResetLink">
                        Open reset password page
                    </MudButton>
                    <MudText Typo="Typo.caption" Class="mt-2" Style="word-break: break-all; opacity: .8;">
                        @_resetLink
                    </MudText>
                </MudAlert>
            }
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                @_error
            </MudAlert>
        }

        @if (string.IsNullOrWhiteSpace(_successMessage))
        {
            <EditForm Model="_model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <MudStack Spacing="2">
                    <MudTextField @bind-Value="_model.Email"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Required="true"
                                  For="@(() => _model.Email)"
                                  InputType="InputType.Email"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email"
                                  Margin="Margin.Dense" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="_isSubmitting"
                               FullWidth="true"
                               ButtonType="ButtonType.Submit">
                        @if (_isSubmitting)
                        {
                            <MudProgressCircular Size="Size.Small" Class="me-2" Indeterminate="true" />
                            <span>Sending...</span>
                        }
                        else
                        {
                            <span>Send reset link</span>
                        }
                    </MudButton>
                </MudStack>
            </EditForm>
        }

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.body2" Align="Align.Center">
            Remember your password?
            <MudLink Href="/login" Typo="Typo.body2">Back to sign in</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private ForgotPasswordVm _model = new();
    private bool _isSubmitting;
    private string? _error;
    private string? _successMessage;
    private string? _resetLink;

    private async Task HandleSubmit()
    {
        _error = null;
        _successMessage = null;
        _resetLink = null;
        _isSubmitting = true;

        try
        {
            var request = new ForgotPasswordRequestDto(_model.Email.Trim());
            var resp = await Http.PostAsJsonAsync("api/auth/forgot-password", request, HttpJson.Options);

            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<ForgotPasswordResponseDto>(HttpJson.Options);
                _successMessage = result?.Message
                    ?? "If an account exists for that email, a password reset link has been sent.";
                _resetLink = result?.ResetLink;

                if (!string.IsNullOrWhiteSpace(_resetLink))
                {
                    Snackbar.Add("Reset link is ready. Click the button below to continue.", Severity.Success);
                }
                else
                {
                    Snackbar.Add(_successMessage, Severity.Success);
                }
            }
            else
            {
                _error = await resp.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(_error))
                {
                    _error = "Unable to process your request. Please try again.";
                }
                Snackbar.Add(_error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the server. Make sure the API is running. ({ex.Message})";
            Snackbar.Add(_error, Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void GoToResetLink()
    {
        if (string.IsNullOrWhiteSpace(_resetLink))
        {
            return;
        }

        var relative = _resetLink;
        if (Uri.TryCreate(_resetLink, UriKind.Absolute, out var absolute))
        {
            relative = absolute.PathAndQuery;
        }

        Nav.NavigateTo(relative);
    }

    private class ForgotPasswordVm
    {
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}

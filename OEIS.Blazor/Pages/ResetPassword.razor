@page "/reset-password"

@using OEIS.Application.DTOs
@using OEIS.Blazor.Services
@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center oeis-login-wrap">
    <MudPaper Elevation="8" Class="pa-8 pa-sm-10 w-100 rounded-xl oeis-login-card oeis-animate-in">
        <div class="text-center mb-6">
            <MudText Typo="Typo.h4" Class="font-weight-bold mb-2">Reset password</MudText>
            <MudText Typo="Typo.body2" Style="opacity:.75">
                Choose a new password for your account.
            </MudText>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                @_error
            </MudAlert>
        }

        @if (string.IsNullOrWhiteSpace(_token))
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                This reset link is invalid or missing. Request a new link from the forgot password page.
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Href="/forgot-password">
                Request reset link
            </MudButton>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <MudStack Spacing="2">
                    <MudTextField Value="_model.Email"
                                  ValueChanged="@((string v) => _model.Email = v)"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Required="true"
                                  For="@(() => _model.Email)"
                                  InputType="InputType.Email"
                                  ReadOnly="true"
                                  Margin="Margin.Dense" />

                    <MudTextField @bind-Value="_model.NewPassword"
                                  Label="New password"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Required="true"
                                  For="@(() => _model.NewPassword)"
                                  InputType="InputType.Password"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Lock"
                                  Margin="Margin.Dense" />

                    <MudTextField @bind-Value="_model.ConfirmPassword"
                                  Label="Confirm new password"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Required="true"
                                  For="@(() => _model.ConfirmPassword)"
                                  InputType="InputType.Password"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Lock"
                                  Margin="Margin.Dense" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="_isSubmitting"
                               FullWidth="true"
                               ButtonType="ButtonType.Submit">
                        @if (_isSubmitting)
                        {
                            <MudProgressCircular Size="Size.Small" Class="me-2" Indeterminate="true" />
                            <span>Updating...</span>
                        }
                        else
                        {
                            <span>Update password</span>
                        }
                    </MudButton>
                </MudStack>
            </EditForm>
        }

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.body2" Align="Align.Center">
            <MudLink Href="/login" Typo="Typo.body2">Back to sign in</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private ResetPasswordVm _model = new();
    private string? _token;
    private bool _isSubmitting;
    private string? _error;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        ApplyQueryParameters();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ApplyQueryParameters();
        InvokeAsync(StateHasChanged);
    }

    private void ApplyQueryParameters()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = uri.Query;
        if (string.IsNullOrEmpty(query) || query.Length < 2)
        {
            return;
        }

        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            var key = Uri.UnescapeDataString(pair[0]);
            var value = pair.Length > 1 ? Uri.UnescapeDataString(pair[1]) : string.Empty;

            if (key.Equals("email", StringComparison.OrdinalIgnoreCase))
            {
                _model.Email = value;
            }
            else if (key.Equals("token", StringComparison.OrdinalIgnoreCase))
            {
                _token = value;
            }
        }
    }

    private async Task HandleSubmit()
    {
        _error = null;

        if (!string.Equals(_model.NewPassword, _model.ConfirmPassword, StringComparison.Ordinal))
        {
            _error = "Passwords do not match.";
            Snackbar.Add(_error, Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(_token))
        {
            _error = "Invalid reset link.";
            return;
        }

        _isSubmitting = true;

        try
        {
            var request = new ResetPasswordRequestDto(
                _model.Email.Trim(),
                _token.Trim(),
                _model.NewPassword);

            var resp = await Http.PostAsJsonAsync("api/auth/reset-password", request, HttpJson.Options);

            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("Password updated. You can sign in now.", Severity.Success);
                Nav.NavigateTo("/login");
            }
            else
            {
                _error = await resp.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(_error))
                {
                    _error = "Unable to reset password. The link may have expired.";
                }
                Snackbar.Add(_error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the server. Make sure the API is running. ({ex.Message})";
            Snackbar.Add(_error, Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private class ResetPasswordVm
    {
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required, MinLength(6)]
        public string NewPassword { get; set; } = string.Empty;

        [Required, Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
